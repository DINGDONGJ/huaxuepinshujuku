@echo off
chcp 65001 >nul
title 智能MSDS爬虫

:MENU
cls
echo.
echo ╔══════════════════════════════════════════════════════════╗
echo ║          智能MSDS爬虫 v2.0 - 一键爬取                    ║
echo ║            只需提供链接，自动完成一切                    ║
echo ╚══════════════════════════════════════════════════════════╝
echo.
echo  功能说明：
echo  • 自动提取化学品名称
echo  • 自动提取mid参数
echo  • 自动创建对应文件夹
echo  • 自动开始爬取
echo.
echo ══════════════════════════════════════════════════════════
echo.

set /p url=请粘贴化学品MSDS页面的完整链接: 

if "%url%"=="" (
    echo.
    echo ❌ 未输入链接！
    echo.
    pause
    goto MENU
)

echo.
echo ══════════════════════════════════════════════════════════
echo  正在分析链接并爬取数据...
echo ══════════════════════════════════════════════════════════
echo.

python auto_scrape_msds.py "%url%"

if errorlevel 1 (
    echo.
    echo ══════════════════════════════════════════════════════════
    echo  ❌ 爬取失败！请检查链接是否正确
    echo ══════════════════════════════════════════════════════════
) else (
    echo.
    echo ══════════════════════════════════════════════════════════
    echo  ✓ 爬取成功！
    echo ══════════════════════════════════════════════════════════
)

echo.
set /p again=是否继续爬取其他化学品？(y/n): 

if /i "%again%"=="y" (
    goto MENU
) else (
    echo.
    echo 感谢使用！
    timeout /t 2 >nul
    exit
)

